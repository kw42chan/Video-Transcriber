# Supabase — project "video-transcriber" (ref gtwbeqhdsjcpavquengm, ap-southeast-1)
# Dashboard: https://supabase.com/dashboard/project/gtwbeqhdsjcpavquengm/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://gtwbeqhdsjcpavquengm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (Vercel production URL or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional for local compile; webhook + checkout need these in prod)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Monthly plans (recurring Price ids from Stripe Dashboard)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# One-time top-up packs (payment mode Price ids)
STRIPE_PRICE_TOPUP_100=
STRIPE_PRICE_TOPUP_320=
# Legacy: if only STRIPE_PRICE_PRO is unset, checkout may fall back to this for Pro
STRIPE_PRICE_ID=

# BYOK encryption (32-byte key, base64) — same value on web + worker
BYOK_ENCRYPTION_KEY=

# Platform API keys (used by worker; listed here for reference only)
# OPENROUTER_API_KEY=
# CANTO_GEN_API_KEY=
# SYNCLABS_API_KEY=
# FAL_KEY=

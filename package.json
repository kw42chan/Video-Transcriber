{
  "name": "phase0-cantonese-tts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 EN→HK 口語 Cantonese dubbing spike + Video-Transcriber SaaS MVP",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "translate": "node scripts/translate-to-hk-kouyu.mjs",
    "tts:canto-gen": "node scripts/tts-canto-gen.mjs",
    "tts:elevenlabs": "node scripts/tts-elevenlabs.mjs",
    "tts:minimax": "node scripts/tts-minimax.mjs",
    "ab": "node scripts/run-ab.mjs",
    "lipsync:cut": "node scripts/cut-lipsync-test.mjs",
    "lipsync:synclabs": "node scripts/lipsync-synclabs.mjs",
    "lipsync:musetalk": "node scripts/lipsync-musetalk.mjs",
    "saas:pipeline": "node scripts/run-saas-pipeline.mjs",
    "web:dev": "npm run dev --workspace=@video-transcriber/web",
    "web:build": "npm run build --workspace=@video-transcriber/web",
    "worker:dev": "npm run dev --workspace=@video-transcriber/worker",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

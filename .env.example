# Dashboard values live in apps/web/.env.local; see apps/web/.env.example.
# Keep the service-role key, Stripe secrets, and BYOK encryption key server-side.

# Phase 0 Day 1 — copy to .env and fill. Never commit real keys.
#
# ── SaaS (web + worker) — Supabase project "video-transcriber" ─────────────
# Ref: gtwbeqhdsjcpavquengm · Region: ap-southeast-1
# URL (public): https://gtwbeqhdsjcpavquengm.supabase.co
# Keys: https://supabase.com/dashboard/project/gtwbeqhdsjcpavquengm/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://gtwbeqhdsjcpavquengm.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# BYOK_ENCRYPTION_KEY=   # openssl rand -base64 32 — same on web + worker
# See docs/MVP_SETUP.md for Vercel, worker, and Stripe steps.

# Canto-Gen (港嘢) — https://canto-gen.com — key needs tts:generate + tts:clone for clone mode
# Official docs also accept CANTOGEN_API_KEY; harness accepts either name.
CANTO_GEN_API_KEY=

# ElevenLabs — https://elevenlabs.io — Instant Voice Clone + eleven_v4 + language_code yue
ELEVENLABS_API_KEY=
# Optional: reuse an existing voice id instead of creating a new IVC each run
ELEVENLABS_VOICE_ID=

# MiniMax Speech T2A — https://platform.minimax.io
# International API (api.minimax.io) uses Bearer only.
# GroupId is optional; some CN accounts still need it — set if your dashboard shows one.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Optional: reuse a previously cloned MiniMax voice_id (skip re-upload)
MINIMAX_VOICE_ID=
# Fallback system Cantonese voice when no clone ref / no MINIMAX_VOICE_ID.
# NEVER use Chinese (Mandarin)_HK_Flight_Attendant — that is Mandarin, not 粵語.
MINIMAX_FALLBACK_VOICE_ID=Cantonese_GentleLady

# OpenRouter — EN → Traditional HK 口語 translation
OPENROUTER_API_KEY=
# Default: strong multilingual; override if you prefer another OpenRouter model
# NOTE: google/*, anthropic/*, openai/* return 403 (provider ToS/region) from the agent box; qwen/deepseek/x-ai work
OPENROUTER_MODEL=qwen/qwen3.8-max

# Optional overrides
# CANTO_GEN_VOICE=sum
# ELEVENLABS_MODEL=eleven_v4
# MINIMAX_MODEL=speech-2.8-hd
# REFS_DIR=refs
# CLIPS_DIR=clips
# OUT_DIR=out

# ── Day 2 lip sync ────────────────────────────────────────────
# Sync Labs (sync.so) — https://sync.so/settings/api-keys — header x-api-key
# Docs name it SYNC_API_KEY; harness accepts either. Free plan: 3 gens/month ≤20s (watermarked).
SYNCLABS_API_KEY=
# Optional: SYNCLABS_MODEL=lipsync-2   SYNCLABS_USD_PER_SEC=0.05   SYNCLABS_PLAN_USD=5

# Fal (MuseTalk fallback) — https://fal.ai/dashboard/keys — header Authorization: Key …
FAL_KEY=
# Optional: FAL_MUSETALK_USD_PER_SEC=0.05  (conservative placeholder; Fal bills GPU-seconds)
